<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Spotineil" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/spotineil_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Spotineil.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spotineil_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Spotineil</item>
    </style>
</resources>
